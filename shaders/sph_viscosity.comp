// Pass 4: smooths particle velocities toward their neighbours using a Poly6
// influence kernel, producing viscous fluid behaviour.
#version 430 core
layout(local_size_x = 256) in;

struct Particle {
    vec4 position;
    vec4 predictedPosition;
    vec4 velocity;
    vec4 densities;
};

layout(std430, binding = 0) buffer ParticleBuffer { Particle particles[]; };

layout(std140, binding = 0) uniform SimUniforms {
    vec4  gravity;
    vec4  boxMin;
    vec4  boxMax;
    float smoothingRadius;
    float smoothingRadius2;
    float targetDensity;
    float pressureMultiplier;
    float nearPressureMultiplier;
    float viscosityStrength;
    float timeStep;
    float collisionDamping;
    int   numParticles;
    float predictionFactor;
    float maxVelocity;
    float _pad0; float _pad1; float _pad2; float _pad3; float _pad4;
};

shared vec4 s_posV[256];
shared vec4 s_vel[256];

float poly6(float r2) {
    float diff = smoothingRadius2 - r2;
    float h9   = smoothingRadius2 * smoothingRadius2 * smoothingRadius2
               * smoothingRadius2 * smoothingRadius;
    return (315.0 / (64.0 * 3.14159265359 * h9)) * diff * diff * diff;
}

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    bool valid = int(i) < numParticles;

    vec3 pi = valid ? particles[i].position.xyz : vec3(1e9);
    vec3 vi = valid ? particles[i].velocity.xyz : vec3(0.0);

    vec3 viscosityForce = vec3(0.0);

    int numTiles = (numParticles + 255) / 256;
    for (int tile = 0; tile < numTiles; tile++) {
        uint j = uint(tile) * 256u + lid;
        if (int(j) < numParticles) {
            s_posV[lid] = particles[j].position;
            s_vel[lid]  = particles[j].velocity;
        } else {
            s_posV[lid] = vec4(1e9, 1e9, 1e9, 0.0);
            s_vel[lid]  = vec4(0.0);
        }
        barrier();

        if (valid) {
            for (int k = 0; k < 256; k++) {
                uint gj = uint(tile) * 256u + uint(k);
                if (gj == i || int(gj) >= numParticles) continue;

                vec3  rij = pi - s_posV[k].xyz;
                float r2  = dot(rij, rij);
                if (r2 >= smoothingRadius2) continue;

                viscosityForce += (s_vel[k].xyz - vi) * poly6(r2);
            }
        }
        barrier();
    }

    if (!valid) return;

    if (viscosityStrength > 0.0)
        particles[i].velocity.xyz += viscosityForce * viscosityStrength * timeStep;
}
